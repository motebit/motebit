{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/motebit/motebit/main/spec/schemas/computer-action-request-v1.json",
  "title": "ComputerActionRequest (v1)",
  "description": "One invocation of the `computer` tool. Action is a nested discriminated variant. See spec/computer-use-v1.md §5.1.",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "Open session the action belongs to."
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "screenshot"
            }
          },
          "required": ["kind"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cursor_position"
            }
          },
          "required": ["kind"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "click"
            },
            "target": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Logical pixel X coordinate."
                },
                "y": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Logical pixel Y coordinate."
                }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            },
            "button": {
              "description": "\"left\" | \"right\" | \"middle\". Defaults to \"left\".",
              "type": "string"
            },
            "modifiers": {
              "description": "Modifier keys held during the action. Subset of `[\"cmd\", \"ctrl\", \"alt\", \"shift\"]`.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "target_hint": {
              "type": "object",
              "properties": {
                "role": {
                  "description": "Accessibility role. Examples: 'button', 'link'.",
                  "type": "string"
                },
                "label": {
                  "description": "Accessible label or visible text.",
                  "type": "string"
                },
                "source": {
                  "type": "string",
                  "description": "Source of the hint: 'accessibility', 'dom', 'vision', 'user_annotation'."
                }
              },
              "required": ["source"],
              "additionalProperties": false
            }
          },
          "required": ["kind", "target"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "double_click"
            },
            "target": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Logical pixel X coordinate."
                },
                "y": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Logical pixel Y coordinate."
                }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            },
            "button": {
              "type": "string"
            },
            "modifiers": {
              "description": "Modifier keys held during the action. Subset of `[\"cmd\", \"ctrl\", \"alt\", \"shift\"]`.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "target_hint": {
              "type": "object",
              "properties": {
                "role": {
                  "description": "Accessibility role. Examples: 'button', 'link'.",
                  "type": "string"
                },
                "label": {
                  "description": "Accessible label or visible text.",
                  "type": "string"
                },
                "source": {
                  "type": "string",
                  "description": "Source of the hint: 'accessibility', 'dom', 'vision', 'user_annotation'."
                }
              },
              "required": ["source"],
              "additionalProperties": false
            }
          },
          "required": ["kind", "target"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mouse_move"
            },
            "target": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Logical pixel X coordinate."
                },
                "y": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Logical pixel Y coordinate."
                }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            },
            "target_hint": {
              "type": "object",
              "properties": {
                "role": {
                  "description": "Accessibility role. Examples: 'button', 'link'.",
                  "type": "string"
                },
                "label": {
                  "description": "Accessible label or visible text.",
                  "type": "string"
                },
                "source": {
                  "type": "string",
                  "description": "Source of the hint: 'accessibility', 'dom', 'vision', 'user_annotation'."
                }
              },
              "required": ["source"],
              "additionalProperties": false
            }
          },
          "required": ["kind", "target"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "drag"
            },
            "from": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Logical pixel X coordinate."
                },
                "y": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Logical pixel Y coordinate."
                }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            },
            "to": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Logical pixel X coordinate."
                },
                "y": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Logical pixel Y coordinate."
                }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            },
            "button": {
              "type": "string"
            },
            "modifiers": {
              "description": "Modifier keys held during the action. Subset of `[\"cmd\", \"ctrl\", \"alt\", \"shift\"]`.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "target_hint": {
              "type": "object",
              "properties": {
                "role": {
                  "description": "Accessibility role. Examples: 'button', 'link'.",
                  "type": "string"
                },
                "label": {
                  "description": "Accessible label or visible text.",
                  "type": "string"
                },
                "source": {
                  "type": "string",
                  "description": "Source of the hint: 'accessibility', 'dom', 'vision', 'user_annotation'."
                }
              },
              "required": ["source"],
              "additionalProperties": false
            }
          },
          "required": ["kind", "from", "to"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "type"
            },
            "text": {
              "type": "string",
              "description": "Text to type."
            },
            "per_char_delay_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["kind", "text"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "key"
            },
            "key": {
              "type": "string",
              "description": "Key combination. Example: 'cmd+c', 'escape'."
            }
          },
          "required": ["kind", "key"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "scroll"
            },
            "target": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Logical pixel X coordinate."
                },
                "y": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Logical pixel Y coordinate."
                }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            },
            "dx": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Scroll wheel delta X."
            },
            "dy": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Scroll wheel delta Y."
            }
          },
          "required": ["kind", "target", "dx", "dy"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "navigate"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "description": "Target URL. Implementations SHOULD normalize relative-looking inputs (`example.com` → `https://example.com`) but MAY reject malformed URLs with a `not_supported` failure. Cloud-browser-only in v1; desktop dispatcher does not implement (no OS-level browser context)."
            }
          },
          "required": ["kind", "url"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "click_element"
            },
            "element_id": {
              "type": "string",
              "description": "Structural id of the element to click, from a prior AX read of the element space."
            }
          },
          "required": ["kind", "element_id"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "focus_element"
            },
            "element_id": {
              "type": "string",
              "description": "Structural id of the element to focus without clicking — avoids click side-effects (dropdowns/dialogs) when setting up a type."
            }
          },
          "required": ["kind", "element_id"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "type_into"
            },
            "element_id": {
              "type": "string",
              "description": "Structural id of the element to type into; the server focuses it first so keystrokes are not swallowed."
            },
            "text": {
              "type": "string",
              "description": "Text to type."
            },
            "per_char_delay_ms": {
              "description": "Per-character delay in ms; same shape as the lower-level `type` action.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "clear_first": {
              "description": "If true (default), clear the field's current value before typing; false appends.",
              "type": "boolean"
            }
          },
          "required": ["kind", "element_id", "text"],
          "additionalProperties": {}
        }
      ],
      "description": "Discriminated action variant. The `kind` field selects the branch."
    }
  },
  "required": ["session_id", "action"],
  "additionalProperties": {}
}
