{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/motebit/motebit/main/spec/schemas/computer-observation-result-v1.json",
  "title": "ComputerObservationResult (v1)",
  "description": "Result payload of a computer-use observation action. Screenshot bytes live in the artifact store; this payload binds to them by hash. See spec/computer-use-v1.md §5.2.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "screenshot"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "Browser-sandbox session this observation belongs to."
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "description": "Artifact ID of the raw capture."
        },
        "artifact_sha256": {
          "type": "string",
          "minLength": 1,
          "description": "SHA-256 of the raw capture bytes."
        },
        "image_format": {
          "type": "string",
          "description": "\"png\" | \"jpeg\"."
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Image width in logical pixels."
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Image height in logical pixels."
        },
        "captured_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix ms."
        },
        "redaction": {
          "type": "object",
          "properties": {
            "applied": {
              "type": "boolean",
              "description": "True iff one or more regions were masked."
            },
            "projection_kind": {
              "type": "string",
              "description": "'raw' | 'masked' | 'blurred' | 'cropped'. Describes the shape of bytes the AI saw."
            },
            "policy_version": {
              "description": "Version of the classification policy that ran.",
              "type": "string"
            },
            "classified_regions_count": {
              "description": "Number of sensitive regions classified in the raw frame.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "classified_regions_digest": {
              "description": "SHA-256 of a canonical JSON array of classified regions. Lets a verifier replay what was masked.",
              "type": "string"
            }
          },
          "required": ["applied", "projection_kind"],
          "additionalProperties": false,
          "description": "Redaction applied to the raw capture before projection, if any."
        },
        "projection_artifact_id": {
          "description": "Artifact ID of the redacted projection when it differs from the raw capture.",
          "type": "string"
        },
        "projection_artifact_sha256": {
          "description": "SHA-256 of the projection bytes. Paired with projection_artifact_id.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "session_id",
        "artifact_id",
        "artifact_sha256",
        "image_format",
        "width",
        "height",
        "captured_at",
        "redaction"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cursor_position"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "Browser-sandbox session this observation belongs to."
        },
        "x": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Cursor X in logical pixels."
        },
        "y": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Cursor Y in logical pixels."
        },
        "captured_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix ms."
        }
      },
      "required": ["kind", "session_id", "x", "y", "captured_at"],
      "additionalProperties": {}
    }
  ]
}
