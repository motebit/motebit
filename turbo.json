{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "vitest.shared.ts",
    "tsconfig.base.json",
    ".node-version",
    "scripts/test-support/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "CI",
        "TZ",
        "LANG",
        "NODE_OPTIONS",
        "LD_LIBRARY_PATH",
        "GITHUB_PAT",
        "MOTEBIT_TEST_RUNTIME"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "CI",
        "TZ",
        "LANG",
        "NODE_OPTIONS",
        "LD_LIBRARY_PATH",
        "GITHUB_PAT",
        "MOTEBIT_TEST_RUNTIME"
      ],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "lint:pack": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "api:extract": {
      "dependsOn": ["build"],
      "outputs": ["etc/**"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
