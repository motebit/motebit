{
  "name": "@motebit/mobile",
  "version": "0.0.0-private",
  "license": "BUSL-1.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "prestart": "pnpm run build:creature-html",
    "preios": "pnpm run build:creature-html",
    "preandroid": "pnpm run build:creature-html",
    "pretest": "pnpm run build:creature-html",
    "pretypecheck": "pnpm run build:creature-html",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "echo 'Mobile build via EAS'",
    "check:build-output": "npx tsx ../../scripts/check-client-build-output.ts mobile --expo-config --dir dist",
    "eas-build-on-success": "npx tsx ../../scripts/check-client-build-output.ts mobile --expo-config --dir android/app/build/generated --dir ios/build",
    "build:creature-html": "node scripts/build-creature-html.mjs",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist .turbo .expo src/creature-webview-bundle.generated.ts"
  },
