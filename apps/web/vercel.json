{
  "framework": "vite",
  "ignoreCommand": "sh ../../scripts/vercel-ignore-build.sh --watch ../../scripts/vercel-watch/web.txt",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "gh-readonly-queue/**": false,
      "dependabot/**": false,
      "changeset-release/**": false
    }
  },
  "rewrites": [
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
