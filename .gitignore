node_modules/
dist/
.turbo/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# api-extractor temp files (generated per run; etc/*.api.md is committed as baseline)
packages/*/etc/temp/

# Build artifacts
*.tgz
*.map
vite.config.ts.timestamp-*
vitest.config.ts.timestamp-*
tsup.config.bundled_*
.next/
next-env.d.ts

# Tauri
apps/desktop/src-tauri/target/

# Expo
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/

# Mobile's WebView render-engine bundle (regenerated by pre* scripts from
# packages/render-engine/dist/browser.iife.js — committing would drift)
apps/mobile/src/creature-webview-bundle.generated.ts

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate*
infra/secrets/
.claude/worktrees/
.vercel

# Strategy docs stay local — competitive posture, not operational doctrine.
docs/strategy/

# Private/archived docs — pulled from the published site, kept locally only.
# e.g. how-we-built-this.mdx (the founder build narrative) was unpublished from
# docs.motebit.com and archived here.
docs/private/

# docs/ops/RUNBOOK.md is intentionally public (operator-transparency doctrine —
# the runbook is the procedural half of what /.well-known/motebit-transparency.json
# declares; see docs/doctrine/operator-transparency.md). docs/ops/SECRETS.md is
# the secrets-topology inventory — no actual values, but documents the
# single-point-of-compromise surface for the relay. That belongs locked down.
docs/ops/SECRETS.md
.npmrc

# Patent filings (confidential, never public)
patents/
PATENT-BLUEPRINT.md

# Service runtime artifacts (identity keys, local SQLite). Generated on
# first `pnpm dev` boot per service. Contains private keys — never commit.
services/*/data/

# Root-level `data/` — the same runtime state, one directory up. Created by a
# root `pnpm dev` boot and NEVER ignored, because the pattern above is anchored
# to services/. A blanket `git add -A` swept `data/motebit.key` (a 64-char hex
# Ed25519 private key), `data/motebit.md`, and the web-search SQLite files onto
# main in b4838674. Ignore the directory wherever it appears, not just where it
# was first noticed.
data/

# Turborepo
.turbo

# devnet rehearsal local state (keys + mint — devnet-only, valueless, but never commit)
.devnet-rehearsal/
# Root-level dot-prefixed scratch scripts. These are one-off live-product-test
# drivers: they carry absolute local paths and test-identity passphrases, and
# two of them (.legC-verify-seam.mts, .poll-task.mts) rode into the tree on an
# unrelated commit and sat there for a week. The class is ignored, not the
# instances.
/.*.mts

# Gate scratch, written at any depth (check-docs-quickstart-runs materializes
# this next to the package it exercises and cleans up after itself — but an
# interrupted run leaves it behind). Kept UNANCHORED on purpose: the pattern
# above is root-only, and folding this filename into it silently narrowed the
# ignore from any-depth to root-only.
.quickstart-check.mts

# Golden-frame darwin snapshots — local personal baselines only; linux
# frames in __screenshots__ are the CI-authoritative committed references.
apps/web/e2e/golden/__screenshots__/*-darwin.png
